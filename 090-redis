#!/bin/bash
# Install the Redis Client + Server from source

source "$(dirname "${BASH_SOURCE[0]}")/./common"

INIT apt-install --lazy --header "Install Redis build dependencies" libsystemd-dev libssl-dev

INIT status "Build Redis from source"
INIT source-clone redis https://github.com/redis/redis.git
INIT go-src redis
make clean
make distclean
make BUILD_TLS=yes USE_SYSTEMD=yes MALLOC=jemalloc
INIT status-done


# NOTE: `make test` failing as of 2026-10-07 so skipped - MC
# INIT status "Testing Redis install"
# make test


# NOTE: Only nuke existing Redis if we pass tests so we can keep existing system Redis running if we have one
INIT apt-remove --lazy --header "Remove Existing Redis APT distributions" redis redis-tools


INIT status "Installing Redis binary"
sudo make install
INIT status-done


if [ ! -d "/etc/redis" ]; then
	INIT status "Setup base Redis config"
	sudo mkdir /etc/redis
	sudo cp redis.conf /etc/redis
	INIT status-done
else
	INIT status-skip "Setup base Redis config - /etc/redis already exists"
fi


if [ ! -f "/etc/systemd/system/redis.service" ]; then
	INIT status "Setup Redis as a SystemD service"

INIT file-set /etc/systemd/system/redis.service <<EOF
[Unit]
Description=Redis
After=syslog.target

[Service]
ExecStart=/usr/local/bin/redis-server /etc/redis/redis.conf
RestartSec=5s
Restart=on-failure

[Install]
WantedBy=multi-user.target
EOF

	sudo systemctl daemon-reload
	sudo systemctl start redis
	sudo systemctl enable redis
	INIT status-done
else
	INIT status-skip "Setup Redis as a SystemD service - already present"
fi
