#!/bin/bash
# Set up a swap file using disk storage, size is set via PROFILE_SWAP_SIZE
#
# NOTE: Use `free -h` to see swap file usage

source "$(dirname "${BASH_SOURCE[0]}")/./common"

SWAP_SIZE=`INIT ask --prompt "Swap file size" --var "PROFILE_SWAP_SIZE" --default "2G"`
SWAP_ROOT="/var"
SWAP_FILE="${SWAP_ROOT}/swap-$(echo "$SWAP_SIZE" | tr '[:upper:]' '[:lower:]').img"

if [ -e "${SWAP_FILE}" ]; then
	INIT panic "Swap file \"${SWAP_FILE}\" already exists - refusing to overwrite"
fi


INIT status "Setting up ${SWAP_SIZE} Swap file"
sudo touch "${SWAP_FILE}"
sudo chmod 0600 "${SWAP_FILE}"
sudo fallocate -l "${SWAP_SIZE}" "${SWAP_FILE}"
sudo truncate "${SWAP_FILE}" --size="${SWAP_SIZE}"
sudo mkswap "${SWAP_FILE}"
sudo swapon "${SWAP_FILE}"

INIT file-set --append /etc/fstab <<EOF
${SWAP_FILE}    none    swap    sw    0    0
EOF
