#!/bin/bash
# Install various games

source "$(dirname "${BASH_SOURCE[0]}")/./common"

INIT status "Install GetDeb repo for APT"
INIT apt-repo-install getdeb http://archive.getdeb.net/getdeb-archive.key 'http://archive.getdeb.net/ubuntu/ xenial-getdeb games'

INIT status "Install common games"
INIT apt-install warsow
