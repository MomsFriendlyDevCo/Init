#!/bin/bash
# Install the Mosh Nightly from source

source "$(dirname "${BASH_SOURCE[0]}")/./common"

INIT apt-install --lazy --header "Install Pre-requisites" \
	libncurses5-dev \
	libprotobuf-dev \
	libssl-dev \
	libutempter-dev \
	perl \
	protobuf-compiler \
	zlib1g-dev \


INIT status "Download + Build Mosh from source"
INIT source-clone mosh https://github.com/mobile-shell/mosh
INIT go-src mosh

if [ -f Makefile ]; then
	make clean
fi

./autogen.sh
./configure
make

sudo make install
INIT status-done



INIT status "Allowing Mosh firewall rule"
sudo ufw allow 60000:61000/udp
INIT status-done
