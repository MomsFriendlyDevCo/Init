#!/bin/bash
# Install Maldet malware scanner

source "$(dirname "${BASH_SOURCE[0]}")/./common"

INIT apt-install --lazy --header "Install Marldet prerequisites" \
	clamav \
	clamav-freshclam \
	inotify-tools \
	moreutils \
	sed \


INIT source-clone maldet 'https://github.com/rfxn/linux-malware-detect.git'
INIT go-src maldet
sudo ./install.sh
INIT status-done


INIT status "Compute Maldet ignore paths"
# Find all mount points and flush to ignore file so Maldet doesn't leave this file system
findmnt --raw --noheadings --output TARGET \
	| grep -v '^/$' \
	| grep -vP '^/(dev|var|run|sys)/' \
	| grep -v '^[[:space:]]*$' \
	| cat /usr/local/maldetect/ignore_paths - \
	| sort --unique \
	| sponge /usr/local/maldetect/ignore_paths
INIT status-done


INIT status "Configure MalDet service"
# Setup root dir as actual monitor path
echo '/' >/usr/local/maldetect/monitor_paths
# Tweak config to point to above path
sed -i 's|^default_monitor_mode=.*|default_monitor_mode="/usr/local/maldetect/monitor_paths"|' /usr/local/maldetect/conf.maldet
# Configure email
sed -i 's!^email_alert=.*!email_alert="1"!' /usr/local/maldetect/conf.maldet
sed -i "s!^email_addr=.*!email_addr=\"daemons+$(hostname)@mfdc.dev\"!" /usr/local/maldetect/conf.maldet
sed -i 's!^email_ignore_clean=.*!email_ignore_clean="0"!' /usr/local/maldetect/conf.maldet
# Start system service
sudo systemctl restart maldet.service
INIT status-done

if [ `INIT file-grep-matches /usr/local/maldetect/conf.maldet 'smtp_relay=""'` == 1 ]; then
	INIT note <<'EOF'
Using server default MTA to send email!
Edit /usr/local/maldetect/conf.maldet and tweak email settings + SMTP if needed
Test email sending with `maldet --test-alert scan email`
EOF
fi
