#!/bin/bash
# Install Rust / Cargo + common Cargo packages

source "$(dirname "${BASH_SOURCE[0]}")/./common"

INIT status "Install / Upgrade Rust"
INIT bin-download-run 'https://sh.rustup.rs' -y --default-toolchain stable
source "$HOME/.cargo/env"
rustup default stable


INIT apt-install --lazy --header "Install Cargo prerequisites" \
	clang \
	cmake \
	libasound2-dev \
	libclang1-20 \
	libexpat1-dev \
	libfreetype6-dev \
	libssl-dev \
	libxcb-composite0-dev \
	pkg-config \


