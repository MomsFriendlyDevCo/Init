#!/bin/bash
# Install LibModSecurity-Nginx Nginx connector

source "$(dirname "${BASH_SOURCE[0]}")/./common"

if [ `INIT bin-available nginx` == 0 ]; then
	INIT status-skip "Nginx not present - skipping LibModSecurity + ModSecurity-Nginx setup"
	exit 0
fi


if [ -e '/usr/local/modsecurity/lib/libmodsecurity.so' ]; then
	INIT status-skip "Nginx LibModSecurity already installed"
else
	INIT apt-install --lazy --header "Install LibModSecurity prerequisites" doxygen libcurl4 libpcre2-dev libtool

	INIT status "Install LibModSecurity"
	INIT source-clone LibModSecurity 'https://github.com/owasp-modsecurity/ModSecurity'
	INIT go-src LibModSecurity
	git submodule update --init --recursive
	INIT tolerate make clean
	./build.sh
	./configure
	make
	sudo make install
	INIT status-done
fi


if [ -e "/etc/nginx/modules-available/ngx_http_modsecurity_module.so" ]; then
	INIT status-skip "ModSecurity-Nginx already installed"
else
	NGINX_VERSION=$(nginx -v 2>&1 | sed -E 's|.*nginx/([0-9.]+).*|\1|')

	INIT status "Install ModSecurity-Nginx"
	INIT source-clone ModSecurity-Nginx 'https://github.com/owasp-modsecurity/ModSecurity-nginx'
	INIT status-done

	INIT status "Build Nginx with ModSecurity-Nginx"
	cd "${INIT_SRC}"
	INIT download "https://nginx.org/download/nginx-${NGINX_VERSION}.tar.gz" "./nginx-${NGINX_VERSION}.tar.gz"
	tar xf "nginx-${NGINX_VERSION}.tar.gz"
	INIT tolerate --quiet rm "nginx-${NGINX_VERSION}.tar.gz"
	cd "nginx-${NGINX_VERSION}"

	INIT tolerate make clean
	sudo ./configure --with-compat --add-dynamic-module="../ModSecurity-Nginx"
	sudo make modules
	INIT tolerate --quiet sudo mkdir -p /etc/nginx/modules-available/ /etc/nginx/modules-enabled/
	sudo cp objs/ngx_http_modsecurity_module.so /etc/nginx/modules-available/
	INIT status-done
fi


if [ -e "/etc/nginx/modsec/main.conf" ]; then
	INIT status-skip "Nginx + ModSecurity config already setup"
else
	INIT status "Nginx + ModSecurity config setup"

	sudo mkdir -p /etc/nginx/modsec
	cd /etc/nginx/modsec
	INIT download 'https://raw.githubusercontent.com/owasp-modsecurity/ModSecurity/v3/master/modsecurity.conf-recommended' 'modsecurity.conf'
	INIT download 'https://raw.githubusercontent.com/owasp-modsecurity/ModSecurity/v3/master/unicode.mapping' 'unicode.mapping'
	sudo sed -i 's/SecRuleEngine DetectionOnly/SecRuleEngine On/' modsecurity.conf

	INIT source-clone crs 'https://github.com/coreruleset/coreruleset.git'
	INIT go-src crs
	cd ..
	INIT tolerate --quiet sudo rm -r /etc/nginx/modsec/crs
	sudo mv crs /etc/nginx/modsec/
	cd /etc/nginx/modsec/crs
	sudo mv crs-setup.conf.example /etc/nginx/modsec/crs/crs-setup.conf

	INIT file-set /etc/nginx/modsec/main.conf <<EOF
Include /etc/nginx/modsec/overrides.conf
Include /etc/nginx/modsec/modsecurity.conf
Include /etc/nginx/modsec/crs/crs-setup.conf
Include /etc/nginx/modsec/crs/rules/*.conf
EOF

	if [ ! -e '/etc/nginx/modsec/overrides.conf' ]; then
		# Create stub overrides file if it doesn't already exist
		touch '/etc/nginx/modsec/overrides.conf'
	fi

	if [ ! -L "/etc/nginx/modules-enabled/ngx_http_modsecurity_module.so" ]; then
		cd "/etc/nginx/modules-enabled"
		ln -s '../modules-available/ngx_http_modsecurity_module.so' .
	fi

	INIT status-done
fi


echo
echo "Install instructions:"
echo "   - Add 'load_module /etc/nginx/modules-enabled/ngx_http_modsecurity_module.so;' in /etc/nginx/nginx.conf file at the top of the file"
echo "   - Add 'modsecurity on;'"
echo "   - Add 'modsecurity_rules_file /etc/nginx/modsec/main.conf;'"
echo "   - Verity Nginx setup with 'nginx -t -c /etc/nginx/nginx.conf'"
echo "   - Test by running: curl -I 'http://localhost/?exec=/bin/bash'"
