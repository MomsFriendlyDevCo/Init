#!/bin/bash
# Disable plain-text password logins

source "$(dirname "${BASH_SOURCE[0]}")/./common"

INIT status "Denying plain-text password logins"
sudo perl -pi -e 's/^\s*#?\s*PasswordAuthentication\s.*$/PasswordAuthentication no/' /etc/ssh/sshd_config

# SSHD uses the first value it finds and drop-ins (e.g. 50-cloud-init.conf) are included before the main config, so override them with an early drop-in
if [ -d /etc/ssh/sshd_config.d ]; then
	INIT status "Denying plain-text password logins (sshd_config.d override)"
INIT file-set /etc/ssh/sshd_config.d/00-init-deny-passwords.conf <<EOF
# Installed by Init/003-deny-passwords
PasswordAuthentication no
EOF
fi


INIT status "Reloading SSHD"
sudo sshd -t
sudo service ssh reload

