#!/bin/bash
# Install Nginx as a HTTP / HTTPS reverse proxy

source "$(dirname "${BASH_SOURCE[0]}")/./common"

INIT status "Install Nginx via Apt"
INIT apt-repo-install nginx https://nginx.org/keys/nginx_signing.key "http://nginx.org/packages/ubuntu $(lsb_release -cs) nginx"
INIT apt-install nginx


# TLS certificate {{{
NGINX_CERT_GLOB='/etc/letsencrypt/live/*/fullchain.pem'
while true; do
	NGINX_CERT=`sudo bash -c "ls -1d $NGINX_CERT_GLOB 2>/dev/null" | head -n 1`

	if [ -n "$NGINX_CERT" ] && sudo test -d "$NGINX_CERT"; then
		NGINX_CERT="${NGINX_CERT%/}/fullchain.pem"
	fi

	NGINX_KEY="`dirname "$NGINX_CERT"`/privkey.pem"

	if [ -n "$NGINX_CERT" ] && sudo test -f "$NGINX_CERT" && sudo test -f "$NGINX_KEY"; then
		break
	fi

	INIT fixme "No LetsEncrypt certificate found matching '$NGINX_CERT_GLOB' (+ privkey.pem alongside it) - install one (e.g. 'sudo certbot certonly --nginx -d <domain>') or enter its path"
	NGINX_CERT_GLOB=`INIT ask --prompt "Path / glob to LetsEncrypt fullchain.pem (or its live directory)" --default "$NGINX_CERT_GLOB"`
done

NGINX_DOMAIN=`basename "$(dirname "$NGINX_CERT")"`
# }}}


INIT status "Configure Nginx for $NGINX_DOMAIN (certificate $NGINX_CERT)"
INIT file-set --confirm /etc/nginx/nginx.conf <<EOF
pid /var/run/nginx.pid;
worker_processes auto; # 'auto' = Use CPU count as worker count

events {
	worker_connections 4096;
}

http {
	# Upload config {{{
	client_max_body_size 500M;
	# }}}

	# Compression {{{
	include /etc/nginx/mime.types;
	default_type application/octet-stream;
	gzip on;
	gzip_http_version 1.0;
	gzip_comp_level 2;
	gzip_proxied any;
	gzip_min_length  1100;
	gzip_buffers 16 8k;
	gzip_types text/plain text/css application/x-javascript text/xml application/xml application/xml+rss text/javascript;
	#  }}}

	# Redirect http -> https {{{
	server {
		listen 80;
		return 301 https://\$host\$request_uri;
	}
	# }}}

	# ${NGINX_DOMAIN} {{{
	server {
		listen 443 ssl http2;
		listen [::]:443 ssl http2;
		server_name ${NGINX_DOMAIN};

		ssl_certificate ${NGINX_CERT};
		ssl_certificate_key ${NGINX_KEY};

		location / {
			proxy_pass http://localhost:8001;
			proxy_redirect off;

			proxy_http_version 1.1;
			proxy_set_header Accept-Encoding "";
			proxy_set_header X-Real-IP \$remote_addr;
			proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
			proxy_set_header Upgrade \$http_upgrade;
			proxy_set_header Connection "upgrade";
			proxy_set_header Host \$host;
			proxy_set_header X-Forwarded-Proto \$scheme;
		}
	}
	# }}}
}
EOF


INIT status "Restart Nginx"
sudo nginx -t
sudo systemctl restart nginx
