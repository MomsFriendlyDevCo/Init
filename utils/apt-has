#!/bin/bash
# Query whether all given packages exist and are installed returning `1` if successful
# Package names can also be a glob expression
# Usage: ./utils/apt-has <pkg...>
#
# @example Query if Foo, Bar and Baz are all installed
# if [ `INIT apt-has foo bar baz` == 1 ]; then echo "Present!"; fi

source "$(dirname "${BASH_SOURCE[0]}")/../common"

HAS_ALL=1

for PKG in "$@"; do
	# `dpkg -l` alone also succeeds for removed (rc) or unknown (un) packages so check the status is 'ii'
	if ! dpkg-query -W -f='${db:Status-Abbrev}\n' "$PKG" 2>/dev/null | grep -q '^ii'; then
		HAS_ALL=0
		break
	fi
done

if [ "$HAS_ALL" == 1 ]; then
	echo "1"
else
	echo "0"
fi
