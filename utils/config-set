#!/bin/bash
# Set a simple INI setting within a file
# Usage: INIT config-set <file> <key> <value>

source "$(dirname "${BASH_SOURCE[0]}")/../common"

INIT apt-install --lazy --header "Installing Perl Pre-requisite" perl

FILE=$1
KEY=$2
VALUE=$3
DATE=`date '+%Y-%m-%dT%H:%M:%SZ%z'`

if sudo grep -qsP "^\s*#?\s*\Q${KEY}\E\s*=" "$FILE"; then
	# Update existing setting - key + value are passed as arguments so they need no escaping
	sudo perl -pi -e 'BEGIN { $key = shift; $val = shift } s/^\s*#?\s*\Q$key\E\s*=.*$/$key=$val/' "$KEY" "$VALUE" "$FILE"
else
	# Append setting

INIT file-set "$FILE" --append <<EOF

# Added by INIT process on $DATE
$KEY=$VALUE

EOF
fi
