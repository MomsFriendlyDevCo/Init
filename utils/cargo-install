#!/bin/bash
# Install a Rust packages, including INIT of Rust + Cargo if necessary
#
# Usage: ./utils/cargo-install [options] <packages...>
#
# --chain                Optimize for multiple cargo installs by installing "sscache" if its not already present
#                        Also implies '--no-clean'
#
# --no-clean             Skip the automatic cleanup - useful if queuing multiple cargo-install commands together
#
# --no-prereq            Skip installing cargo prerequisites
#
# Respects PROFILE_CARGO_INSTALL_OPTIMIZE (see ./profile) to reduce RAM/CPU usage during builds

source "$(dirname "${BASH_SOURCE[0]}")/../common"

# Argument processing {{{
ARG_CLEAN=1
ARG_CHAIN=0
ARG_PREREQ=1
PARAMS=()
while (( "$#" )); do
	case "$1" in
		-c|--chain)
			ARG_CHAIN=1
			ARG_CLEAN=0
			shift
			;;
		--no-clean)
			ARG_CLEAN=0
			shift
			;;
		--no-prereq)
			ARG_PREREQ=0
			shift
			;;
		--) # end argument parsing
			shift
			break
			;;
		-*|--*=) # unsupported flags
			PARAMS+=("$1")
			shift
			;;
		*) # preserve positional arguments
			PARAMS+=("$1")
			shift
			;;
	esac
done
# }}}


# Install a lighter linker (LLD) than the GNU default
if [[ "${ARG_PREREQ}" == 1 && `INIT bin-available ld.lld` == 0 ]]; then
	INIT apt-install --lazy --header "Install Cargo pre-requsite: lld" lld
fi

# Use LLD if available
if [[ `INIT bin-available ld.lld` == 1 ]]; then
	export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }-C link-arg=-fuse-ld=lld"
fi


# Determine whether to use low-resource build settings
CARGO_OPTIMIZE=`get_profile_var PROFILE_CARGO_INSTALL_OPTIMIZE 0`
if [ "${CARGO_OPTIMIZE}" == 'auto' ]; then
	if [ `nproc` -gt 2 ]; then
		CARGO_OPTIMIZE=1
	else
		CARGO_OPTIMIZE=0
	fi
fi

if [ "${CARGO_OPTIMIZE}" == 1 ]; then
	export CARGO_PROFILE_RELEASE_LTO=false # LTO is a huge RAM spike at link time
	export CARGO_PROFILE_RELEASE_CODEGEN_UNITS=16 # Undo any codegen-units=1 the crate sets
	export CARGO_PROFILE_RELEASE_DEBUG=0
	export CARGO_PROFILE_RELEASE_OPT_LEVEL=s # Less LLVM work, slightly slower binary
fi


# Set Cargo build directory to local home as /tmp is a RAM backed tmpfs (limited to 500mb on Ubuntu 26.04 default installs)
export CARGO_TARGET_DIR="$HOME/.cargo-build"


# Enable cargo install caching - to let Rust reuse existing package builds
if [[ "${ARG_CHAIN}" == 1 && `INIT bin-available sccache` == 0 ]]; then
	INIT status "Install Cargo pre-requsite: sccache"
	cargo install --locked sccache
fi

# Use sccache wrapper if available - to enable build reuse
if [[ `INIT bin-available sccache` == 1 ]]; then
	export RUSTC_WRAPPER=sccache
fi


# Check cargo-cache is installed so we can easily purge the cache later
if [[ "${ARG_PREREQ}" == 1 && `INIT bin-available cargo-cache` == 0 ]]; then
	INIT status "Install Cargo pre-requsite: cargo-cache"
	cargo install cargo-cache
fi


cargo install "${PARAMS[@]}"


# Optional cleanup (unless --no-clean)
if [ "${ARG_CLEAN}" == '1' ]; then
	INIT status "Clear cargo cache"
	# Try to recover some disk space post compile of cargo-binstall
	cargo cache -a
fi
