#!/bin/bash
# Install a Rust packages, including INIT of Rust + Cargo if necessary
#
# Usage: ./utils/cargo-install [options] <packages...>
#
# --no-clean             Skip the automatic cleanup - useful if queuing multiple cargo-install commands together
#
# --no-prereq            Skip installing cargo prerequisites

source "$(dirname "${BASH_SOURCE[0]}")/../common"

# Argument processing {{{
ARG_CLEAN=1
ARG_PREREQ=1
PARAMS=()
while (( "$#" )); do
	case "$1" in
		--no-clean)
			ARG_CLEAN=0
			shift
			;;
		--no-prereq)
			ARG_PREREQ=0
			shift
			;;
		--) # end argument parsing
			shift
			break
			;;
		-*|--*=) # unsupported flags
			PARAMS+=("$1")
			shift
			;;
		*) # preserve positional arguments
			PARAMS+=("$1")
			shift
			;;
	esac
done
# }}}


# Enable cargo install caching - to let Rust reuse existing package builds
if [[ "${ARG_PREREQ}" == 1 && `INIT bin-available sccache` == 0 ]]; then
	INIT status "Install Cargo pre-requsite: sccache"
	cargo install sccache
fi
# Use sccache wrapper - to enable build reuse
export RUSTC_WRAPPER=sccache


# Check cargo-cache is installed so we can easily purge the cache later
if [[ "${ARG_PREREQ}" == 1 && `INIT bin-available cargo-cache` == 0 ]]; then
	INIT status "Install Cargo pre-requsite: cargo-cache"
	cargo install cargo-cache
fi


# Set Cargo tmp directory to local home as /tmp is limited to 500mb on Ubuntu 26.04 default installs
export CARGO_TARGET_DIR="$HOME/.cargo/tmp"
cargo install "${PARAMS[@]}"


# Optional cleanup (unless --no-clean)
if [ "${ARG_CLEAN}" == '1' ]; then
	INIT status "Clear cargo cache"
	# Try to recover some disk space post compile of cargo-binstall
	cargo cache -a
fi
