#!/bin/bash
# Install one or more URL deb packages
# Usage: ./utils/apt-install-url <urls...>

source "$(dirname "${BASH_SOURCE[0]}")/../common"

INIT go-src

INIT rm-lazy --header "Erasing existing Source directory" "$INIT_SRC/deb"
mkdir "$INIT_SRC/deb"
cd "$INIT_SRC/deb"

INIT file-download-url "$@"

INIT status "Installing .DEB files"
sudo dpkg -i *.deb

cd "$INIT_SRC"
INIT rm-lazy --header "Cleaning up .DEB files" "$INIT_SRC/deb"

# Go back to base
cd "$INIT_HOME"
