#!/bin/bash
# Fix the MOTD on Ubuntu to STFU

source "$(dirname "${BASH_SOURCE[0]}")/./common"

INIT status "Blank the MOTD"
echo "" | sudo tee /etc/motd.tail >/dev/null
echo "" | sudo tee /etc/motd >/dev/null
INIT status-done

INIT rm-lazy --sudo --header "Disable all UpdateMotd scripts" /etc/ssh/sshd_banner '/etc/update-motd.d/*'
