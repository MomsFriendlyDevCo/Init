#!/bin/bash
# Adjust swappiness (cache RAM usage) for OS's that really care about total RAM used, value is set via PROFILE_SWAPPINESS

source "$(dirname "${BASH_SOURCE[0]}")/./common"

SWAPINESS=`INIT ask --prompt "Swappiness value" --var "PROFILE_SWAPPINESS" --default "30"`

INIT status "Releasing cache memory"
sudo sysctl -w vm.drop_caches=3
INIT status-done


INIT status "Adjusting swappiness"

# Lower swappiness = cache agressively in RAM, higher = swap to disk more (use less cache RAM)
sudo sysctl "vm.swappiness=${SWAPINESS}"

INIT config-set /etc/sysctl.conf 'vm.swappiness' "${SWAPINESS}"

INIT status-done
