#!/bin/bash
# Install common server seucirty hardening tools

source "$(dirname "${BASH_SOURCE[0]}")/./common"


if [ `INIT bin-available maldet` != 1 ]; then
	INIT panic "maldet binary not available - run ./300-security-maldet first"
fi


INIT status "Performing MalDet scan"
sudo `which maldet` --scan-all /
INIT status-done
